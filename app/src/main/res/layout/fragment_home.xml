<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.HomeFragment">

    <TextView
        android:id="@+id/tvNoteCnt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12 notes"
        android:textColor="#6B778C"
        android:textSize="17sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notes"
        android:textColor="#14213D"
        android:textStyle="bold"
        android:textSize="28sp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvNoteCnt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"/>

    <ImageButton
        android:id="@+id/btnSortBy"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_sort"
        android:src="@drawable/ic_sort"
        android:padding="17dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="14dp"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"
        app:layout_constraintEnd_toStartOf="@id/btnTrash"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnTrash"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_trash"
        android:src="@drawable/ic_trash"
        android:padding="3dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/mdSpace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/etSearch"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"/>

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="15dp"
        android:paddingHorizontal="28dp"
        android:paddingVertical="18dp"
        android:background="@drawable/bg_search"
        android:hint="Search notes"
        app:layout_constraintTop_toBottomOf="@id/mdSpace" />

    <HorizontalScrollView
        android:id="@+id/sVChipWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/etSearch">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgColors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="0dp"
            app:chipSpacingVertical="0dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/cpDefault"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="All"
                android:textStyle="bold"
                android:textSize="16sp"
                android:checked="true"
                style="@style/CustomChipNameStyle"
                app:chipEndPadding="8dp"
                app:chipStartPadding="8dp"
                app:chipCornerRadius="20dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/CDE8F6"
                style="@style/CustomChipStyle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:checked="false"
                app:chipBackgroundColor="#CDE8F6"
                app:chipCornerRadius="25dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/CFEEDD"
                style="@style/CustomChipStyle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:checked="false"
                app:chipBackgroundColor="#CFEEDD"
                app:chipCornerRadius="25dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/FBEFB5"
                style="@style/CustomChipStyle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:checked="false"
                app:chipBackgroundColor="#FBEFB5"
                app:chipCornerRadius="25dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/FAD9C4"
                style="@style/CustomChipStyle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:checked="false"
                app:chipBackgroundColor="#FAD9C4"
                app:chipCornerRadius="25dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/F8D0D8"
                style="@style/CustomChipStyle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:checked="false"
                app:chipBackgroundColor="#F8D0D8"
                app:chipCornerRadius="25dp"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/DDD8F7"
                style="@style/CustomChipStyle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:checked="false"
                app:chipBackgroundColor="#DDD8F7"
                app:chipCornerRadius="25dp"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvSortDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Newest first · tap ⇅ for oldest first"
        android:textColor="#6B778C"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sVChipWrapper"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvSortDesc"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/faBtnCreate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:backgroundTint="#0F8B8D"
        android:src="@drawable/ic_add"
        android:scaleType="fitXY"
        app:fabCustomSize="65dp"
        app:maxImageSize="28dp"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>