<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mlWrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBEFB5"
    tools:context=".ui.detail.DetailFragment"
    app:layoutDescription="@xml/fragment_detail_scene">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_trash"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnDismiss"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_trash"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <TextView
        android:id="@+id/tvEditTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Edit note"
        android:textStyle="bold"
        android:textColor="#14213D"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@id/btnUpdate"
        app:layout_constraintStart_toEndOf="@id/btnDismiss"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"/>

    <Button
        android:id="@+id/btnUpdate"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:background="@drawable/bg_update"
        android:textColor="#fff"
        android:text="Update"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"/>

    <ImageButton
        android:id="@+id/btnCopy"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_trash"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_copy"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"
        app:layout_constraintEnd_toStartOf="@id/btnEdit"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnEdit"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_trash"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_edit"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"
        app:layout_constraintEnd_toStartOf="@id/btnTrash"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnTrash"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_trash"
        android:src="@drawable/ic_trash"
        android:padding="3dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/mdSpace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/vsNoteTitleSwitch"
        app:layout_constraintTop_toBottomOf="@id/btnTrash"/>

    <ViewSwitcher
        android:id="@+id/vsNoteTitleSwitch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/mdSpace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tvNoteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Weekend Plan"
            android:textColor="#14213D"
            android:textStyle="bold"
            android:textSize="34sp"/>
        <EditText
            android:id="@+id/etNoteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@null"
            android:autofillHints="@null"
            android:hint="Example"
            android:inputType="text"
            android:textColor="#14213D"
            android:textStyle="bold"
            android:textSize="34sp"/>
    </ViewSwitcher>

    <TextView
        android:id="@+id/tvNoteDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Edited yesterday, 6:12 PM"
        android:textColor="#727A8B"
        android:textSize="16.5sp"/>

    <ScrollView
        android:id="@+id/svWrapper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="18dp"
        android:paddingBottom="280dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvNoteDate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ViewSwitcher
            android:id="@+id/vsNoteContentSwitcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvNoteContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16.5sp"
                android:textColor="#14213D"
                android:singleLine="false"
                android:text="Try the new ramen place on Mill Street, then walk by the river.Call Ria about Saturday. She said the afternoon works best.Bring the camera and the green umbrella. Rain is possible after 4."/>
            <EditText
                android:id="@+id/etNoteContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:autofillHints="@null"
                android:hint="Example..."
                android:inputType="textMultiLine"
                android:textSize="16.5sp"
                android:textColor="#14213D"/>
        </ViewSwitcher>

    </ScrollView>

    <TextView
        android:id="@+id/tvColourTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="Colour"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sVChipWrapper" />


    <HorizontalScrollView
        android:id="@+id/sVChipWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btnRemove">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgColors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/CDE8F6"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:checked="false"
                style="@style/CustomChipStyle"
                app:chipBackgroundColor="#CDE8F6"
                app:chipCornerRadius="100dp"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/CFEEDD"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:checked="false"
                style="@style/CustomChipStyle"
                app:chipBackgroundColor="#CFEEDD"
                app:chipCornerRadius="25dp"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/FBEFB5"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:checked="false"
                style="@style/CustomChipStyle"
                app:chipBackgroundColor="#FBEFB5"
                app:chipCornerRadius="25dp"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/FAD9C4"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:checked="false"
                style="@style/CustomChipStyle"
                app:chipBackgroundColor="#FAD9C4"
                app:chipCornerRadius="25dp"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/F8D0D8"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:checked="false"
                style="@style/CustomChipStyle"
                app:chipBackgroundColor="#F8D0D8"
                app:chipCornerRadius="25dp"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/DDD8F7"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:checked="false"
                style="@style/CustomChipStyle"
                app:chipBackgroundColor="#DDD8F7"
                app:chipCornerRadius="25dp"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btnRemove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="135dp"
        android:padding="14dp"
        android:text="Move To Trash"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#D6455D"
        android:background="@drawable/bg_remove"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.motion.widget.MotionLayout>