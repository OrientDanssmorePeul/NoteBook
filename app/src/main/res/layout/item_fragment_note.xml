<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mcvNoteCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#CFEEDD"
    app:cardCornerRadius="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvNoteTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/segoe_ui_bold"
            android:layout_marginTop="6dp"
            android:text="Groceries"
            android:textColor="#14213D"
            android:textSize="24sp"/>
        <TextView
            android:id="@+id/tvNoteContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Coffee beans"
            android:fontFamily="@font/segoe_ui_true"
            android:textColor="#D914213D"
            android:textSize="22sp"
            android:maxLines="5"/>
        <TextView
            android:id="@+id/tvNoteCreatedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/segoe_ui_true"
            android:text="Today"
            android:textColor="#9914213D"
            android:textSize="19sp"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>