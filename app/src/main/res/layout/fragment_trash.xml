<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F7F9FB"
    tools:context=".ui.trash.TrashFragment">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_trash"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEditTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Trash"
        android:textStyle="bold"
        android:textColor="#14213D"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/btnEmpty"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"/>

    <TextView
        android:id="@+id/btnEmpty"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:textColor="#D6455D"
        android:text="Empty"
        android:textStyle="bold"
        android:textSize="17sp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mdSpace"/>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/mdSpace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/tvInfo"
        app:layout_constraintTop_toBottomOf="@id/tvEditTitle"/>

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Notes are removed after 30 days"
        android:textColor="#727A8B"
        android:textSize="15sp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/mdSpace"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDeletedNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="20dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_search"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/tvInfo"/>

    <TextView
        android:id="@+id/tvInfoTwo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Restored notes come back with their colour."
        android:textAlignment="center"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="30dp"
        android:textColor="#727A8B"
        app:layout_constraintTop_toBottomOf="@id/rvDeletedNotes"/>

</androidx.constraintlayout.widget.ConstraintLayout>