<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Transition
        app:constraintSetStart="@+id/start"
        app:constraintSetEnd="@+id/end"
        app:duration="400">
        <OnClick
            app:clickAction="transitionToEnd"
            app:targetId="@+id/btnEdit"/>
    </Transition>

    <Transition
        app:constraintSetStart="@+id/start"
        app:constraintSetEnd="@+id/end"
        app:duration="400">
        <OnClick
            app:clickAction="transitionToStart"
            app:targetId="@+id/btnDismiss"/>
    </Transition>

    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@id/btnDismiss">
            <PropertySet
                android:alpha="0"
                android:visibility="invisible"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="false"/>
        </Constraint>
        <Constraint
            android:id="@id/tvEditTitle">
            <PropertySet
                android:alpha="0"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="false"/>
        </Constraint>
        <Constraint
            android:id="@id/btnUpdate">
            <PropertySet
                android:alpha="0"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="false"/>
        </Constraint>
        <Constraint
            android:id="@+id/btnCopy">
            <PropertySet
                android:alpha="1"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="true"/>
        </Constraint>
        <Constraint
            android:id="@+id/btnTrash">
            <PropertySet
                android:alpha="1"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="true"/>
        </Constraint>
        <Constraint
            android:id="@+id/btnEdit">
            <PropertySet
                android:alpha="1"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="true"/>
        </Constraint>
        <Constraint
            android:id="@+id/tvNoteDate">
            <Layout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/vsNoteTitleSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </Constraint>
        <Constraint
            android:id="@+id/tvColourTitle">
            <Transform android:translationX="-1000dp"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="false"/>
        </Constraint>
        <Constraint
            android:id="@+id/sVChipWrapper">
            <Transform android:translationX="-1000dp"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="false"/>
        </Constraint>
        <Constraint
            android:id="@+id/btnRemove">
            <Transform android:translationY="1000dp"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="false"/>
        </Constraint>
    </ConstraintSet>



    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@id/btnDismiss">
            <PropertySet
                android:alpha="1"
                android:visibility="visible"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="true"/>
        </Constraint>
        <Constraint
            android:id="@id/btnUpdate">
            <PropertySet
                android:alpha="1"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="true"/>
        </Constraint>
        <Constraint
            android:id="@+id/btnCopy">
            <PropertySet
                android:alpha="0"
                android:visibility="invisible"/>
            <Layout
                app:layout_constraintEnd_toEndOf="@id/btnTrash"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="false"/>
        </Constraint>
        <Constraint
            android:id="@+id/btnEdit">
            <PropertySet
                android:alpha="0"
                android:visibility="invisible"/>
            <Layout
                app:layout_constraintEnd_toEndOf="@id/btnTrash"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="false"/>
        </Constraint>
        <Constraint
            android:id="@+id/btnTrash">
            <PropertySet
                android:alpha="0"
                android:visibility="invisible"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="false"/>
        </Constraint>
        <Constraint
            android:id="@+id/tvNoteDate">
            <Layout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/vsNoteTitleSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </Constraint>
        <Constraint
            android:id="@+id/tvColourTitle">
            <Transform android:translationX="0dp"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="true"/>
        </Constraint>
        <Constraint
            android:id="@+id/sVChipWrapper">
            <Transform android:translationX="0dp"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="true"/>
        </Constraint>
        <Constraint
            android:id="@+id/btnRemove">
            <Transform android:translationY="0dp"/>
            <CustomAttribute
                app:attributeName="enabled"
                app:customBoolean="true"/>
        </Constraint>
    </ConstraintSet>
</MotionScene>
